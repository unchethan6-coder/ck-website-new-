# Copy this file to .env.local and fill in your actual IDs

# ========== GOOGLE ANALYTICS ==========
# Get from: Google Analytics > Data Streams > Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ========== GOOGLE ADS CONVERSION TRACKING ==========
# Get from: Google Ads > Tools > Conversions
# AW-XXXXXXXXXX is your Conversion ID
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
GOOGLE_ADS_CONVERSION_ID=XXXXXXXXXX
GOOGLE_ADS_CONVERSION_LABEL=XXXXXXXXXX

# ========== META PIXEL (FACEBOOK ADS) ==========
# Get from: Meta Business Suite > Events Manager > Pixel ID
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=XXXXXXXXXX

# ========== GOOGLE SEARCH CONSOLE ==========
# Get from: Google Search Console > Verification token
GOOGLE_SEARCH_CONSOLE_ID=XXXXXXXXXX

# ========== OPTIONAL: EMAIL SERVICE ==========
# For contact form submissions and marketing emails
SENDGRID_API_KEY=SG.XXXXXXXXXX
SENDGRID_FROM_EMAIL=support@ckcapital.co.uk

# ========== OPTIONAL: CRM INTEGRATION ==========
# For customer data management
HUBSPOT_API_KEY=XXXXXXXXXX

# ========== OPTIONAL: ANALYTICS BACKUP ==========
# Alternative analytics platform
MIXPANEL_TOKEN=XXXXXXXXXX
